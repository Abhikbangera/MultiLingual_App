              {t('app.title')}
            </span>
          </Link>

          {/* Right side - Language selector & Dashboard link */}
          <div className="flex items-center space-x-4">
            {/* Language Selector */}
            <div className="flex items-center space-x-2">
              <span className="text-lg">🌐</span>
              <select
                value={language}
                onChange={handleLanguageChange}
                className="bg-gradient-to-r from-primary-100 to-secondary-100 border-2 border-primary-300 rounded-xl px-3 py-1.5 text-sm font-bold text-gray-700 focus:outline-none focus:ring-2 focus:ring-primary-400 cursor-pointer"
              >
                <option value="en">{t('language.english')}</option>
                <option value="hi">{t('language.hindi')}</option>
                <option value="pa">{t('language.punjabi')}</option>
