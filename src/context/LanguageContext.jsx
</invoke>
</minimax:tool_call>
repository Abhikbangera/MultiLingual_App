// Language Context for multilingual support
import React, { createContext, useContext, useState, useEffect } from 'react';
import english from '../languages/english.json';
import hindi from '../languages/hindi.json';
import punjabi from '../languages/punjabi.json';

const LanguageContext = createContext();

const translations = {
  en: english,
  hi: hindi,
  pa: punjabi
};

export const LanguageProvider = ({ children }) => {
  const [language, setLanguage] = useState(() => {
    // Get saved language from localStorage or default to English
    const saved = localStorage.getItem('selectedLanguage');
    return saved || 'en';
  });

  useEffect(() => {
    // Save language preference
    localStorage.setItem('selectedLanguage', language);
  }, [language]);

  const t = (key) => {
    // Support nested keys like "app.title" or "subjects.maths.name"
    const keys = key.split('.');
    let value = translations[language];
    
    for (const k of keys) {
      if (value && typeof value === 'object' && k in value) {
        value = value[k];
      } else {
        // Fallback to English if key not found
        let engValue = translations.en;
        for (const ek of keys) {
          if (engValue && typeof engValue === 'object' && ek in engValue) {
            engValue = engValue[ek];
          } else {
            return key; // Return the key if not found
          }
        }
        return engValue;
      }
    }
    
    return value || key;
  };

  const changeLanguage = (lang) => {
    if (['en', 'hi', 'pa'].includes(lang)) {
      setLanguage(lang);
    }
  };

  const getLanguageName = (lang) => {
    const names = {
      en: t('language.english'),
      hi: t('language.hindi'),
      pa: t('language.punjabi')
    };
    return names[lang] || lang;
  };

  const value = {
    language,
    setLanguage: changeLanguage,
    t,
    getLanguageName,
    availableLanguages: [
      { code: 'en', name: t('language.english'), flag: '🇬🇧' },
      { code: 'hi', name: t('language.hindi'), flag: '🇮🇳' },
      { code: 'pa', name: t('language.punjabi'), flag: '🏏' }
    ]
  };

  return (
    <LanguageContext.Provider value={value}>
      {children}
    </LanguageContext.Provider>
  );
};

export const useLanguage = () => {
  const context = useContext(LanguageContext);
  if (!context) {
    throw new Error('useLanguage must be used within a LanguageProvider');
  }
  return context;
};

export default LanguageContext;
